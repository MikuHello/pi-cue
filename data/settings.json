{
  "enabled": {
    "type": "boolean",
    "default": true
  },
  "notifyOnError": {
    "type": "boolean",
    "default": true
  },
  "notifyOnAbort": {
    "type": "boolean",
    "default": false
  },
  "minWorkMs": {
    "type": "integer",
    "default": 0,
    "minimum": 0,
    "maximum": 86400000
  },
  "minAwayMs": {
    "type": "integer",
    "default": 0,
    "minimum": 0,
    "maximum": 86400000
  },
  "language": {
    "type": "string",
    "default": "en",
    "enum": [
      "en",
      "zh-CN"
    ]
  },
  "nativeNotification": {
    "type": "boolean",
    "default": true
  },
  "backend": {
    "type": "string",
    "default": "auto",
    "enum": [
      "auto",
      "macos",
      "windows",
      "linux"
    ]
  },
  "notifyWhenFocused": {
    "type": "boolean",
    "default": false
  },
  "notifyWhenUnfocused": {
    "type": "boolean",
    "default": true
  },
  "notificationTitle": {
    "type": "string",
    "default": "Pi: {session}",
    "maxLength": 512,
    "template": true
  },
  "notificationBody": {
    "type": "string",
    "default": "",
    "maxLength": 4096,
    "template": true,
    "multiline": true
  },
  "soundEnabled": {
    "type": "boolean",
    "default": true
  },
  "soundWhenFocused": {
    "type": "boolean",
    "default": true
  },
  "soundWhenUnfocused": {
    "type": "boolean",
    "default": true
  },
  "soundPreset": {
    "type": "string",
    "default": "system"
  },
  "soundFile": {
    "type": "string",
    "default": "",
    "maxLength": 4096
  },
  "markerEnabled": {
    "type": "boolean",
    "default": true
  },
  "markWhenUnfocused": {
    "type": "boolean",
    "default": true
  },
  "markerPrefix": {
    "type": "string",
    "default": "[!] ",
    "maxLength": 64
  },
  "clearOnFocus": {
    "type": "boolean",
    "default": true
  },
  "clearOnStart": {
    "type": "boolean",
    "default": true
  },
  "unknownFocusPolicy": {
    "type": "string",
    "default": "unfocused",
    "enum": [
      "unfocused",
      "focused",
      "silent"
    ]
  },
  "notifyOnAsk": {
    "type": "boolean",
    "default": false
  },
  "subagentNotifications": {
    "type": "boolean",
    "default": false
  },
  "subagentOnSuccess": {
    "type": "boolean",
    "default": true
  },
  "subagentOnFailure": {
    "type": "boolean",
    "default": true
  },
  "headlessNotifications": {
    "type": "boolean",
    "default": false,
    "const": false
  }
}
